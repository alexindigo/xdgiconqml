#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
BUILD_DIR="${PROJECT_DIR}/${1:-build-dev}"

QMLTESTRUNNER=""
for candidate in \
    /usr/lib/qt6/bin/qmltestrunner \
    /usr/lib/x86_64-linux-gnu/qt6/bin/qmltestrunner \
    /usr/lib64/qt6/bin/qmltestrunner; do
    if [ -x "$candidate" ]; then
        QMLTESTRUNNER="$candidate"
        break
    fi
done

if [ -z "$QMLTESTRUNNER" ]; then
    QMLTESTRUNNER=$(command -v qmltestrunner 2>/dev/null || true)
fi

if [ -z "$QMLTESTRUNNER" ]; then
    echo "error: qmltestrunner not found. Install qt6-declarative-dev-tools."
    exit 1
fi

export QML_IMPORT_PATH="${BUILD_DIR}"
export XDG_DATA_DIRS="${PROJECT_DIR}/tests/assets"
export QS_ICON_THEME="testtheme"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}"

"$QMLTESTRUNNER" -v2 -input "${PROJECT_DIR}/tests/test_xdgicon.qml"
