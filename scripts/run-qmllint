#!/usr/bin/env bash
# scripts/run-qmllint — invoke Qt6 qmllint against examples/
#
# The qmllint binary on PATH is often Qt5's v1.0, which silently ignores
# .qmllint.ini and reports nothing. This script finds a Qt6 qmllint and
# rejects anything older.
#
# --max-warnings 0 turns warnings into a non-zero exit code so this is
# usable as a CI gate.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

pick_qmllint() {
    local candidates=(
        qmllint-qt6
        qmllint6
        /usr/lib/x86_64-linux-gnu/qt6/bin/qmllint
        /usr/lib/qt6/bin/qmllint
        /usr/lib/qt/qt6/bin/qmllint
    )

    # Also consider whatever `qmllint` on PATH resolves to — some distros
    # ship Qt6's binary under that name directly. Only accept it if the
    # version is >= 6.
    local on_path
    on_path="$(command -v qmllint 2>/dev/null || true)"
    [[ -n "$on_path" ]] && candidates+=("$on_path")

    for cand in "${candidates[@]}"; do
        if command -v "$cand" >/dev/null 2>&1 || [[ -x "$cand" ]]; then
            local ver major
            ver="$("$cand" --version 2>&1 | awk '{print $NF}')"
            major="${ver%%.*}"
            if [[ "$major" =~ ^[0-9]+$ ]] && ((major >= 6)); then
                echo "$cand"
                return 0
            fi
        fi
    done
    return 1
}

QMLLINT="$(pick_qmllint)" || {
    echo "WARNING: No Qt6 qmllint found (need version >= 6.0). Skipping." >&2
    echo "         Install qt6-declarative-dev-tools or equivalent." >&2
    exit 0
}

BUILD_DIR="${PROJECT_DIR}/build-dev"
[[ -d "$BUILD_DIR" ]] || {
    echo "ERROR: build-dev/ not found. Run scripts/build-dev first." >&2
    exit 2
}

exec "$QMLLINT" -I "$BUILD_DIR" --max-warnings 0 "${PROJECT_DIR}"/examples/*.qml
