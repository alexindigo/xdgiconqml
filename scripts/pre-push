#!/usr/bin/env bash
# pre-push: run CI checks before pushing. If any fail, the push is blocked.
# This catches broken CI-YAML, formatting violations, qmllint warnings,
# and test failures before they reach GitHub.

set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_DIR="$(dirname "$(dirname "$HOOK_DIR")")"

CHECK_SCRIPT="${REPO_DIR}/scripts/run-ci-local"

if [[ ! -x "$CHECK_SCRIPT" ]]; then
    echo "pre-push: run-ci-local not found, skipping." >&2
    exit 0
fi

if ! "$CHECK_SCRIPT"; then
    echo "" >&2
    echo "  ---------------------------------------------------------------" >&2
    echo "  Pre-push CI checks failed. Fix the issues above, then push." >&2
    echo "  ---------------------------------------------------------------" >&2
    exit 1
fi
